<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header><a href="/">Portfolio</a></header>
  <main>
    <h1>{{ title }}</h1>
    {% if date %}<p><time datetime="{{ date }}">{{ date }}</time></p>{% endif %}
    {{ content | safe }}
  </main>
</body>
</html>
