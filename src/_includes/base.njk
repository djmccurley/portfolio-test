<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chivo:ital,wght@0,100..900;1,100..900&display=swap">
  <link rel="stylesheet" href="/style.css">
  {%- if '<a class="zoom"' in content %}
  <script src="/lightbox.js" defer></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <header><div class="header-row"><a class="site-name" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ site.name }}</a><nav aria-label="Main"><ul>
    <li><a href="/work/"{% if page.url == "/work/" %} aria-current="page"{% elif section == "work" %} aria-current="true"{% endif %}>Work</a></li>
    {% if "cv" not in hiddenNav %}<li><a href="/cv/"{% if page.url == "/cv/" %} aria-current="page"{% endif %}>CV</a></li>{% endif %}
    {% if "teaching" not in hiddenNav %}<li><a href="/teaching/"{% if page.url == "/teaching/" %} aria-current="page"{% endif %}>Teaching</a></li>{% endif %}
  </ul></nav></div></header>
  <main id="main" tabindex="-1">
    <h1>{{ title }}</h1>
    {% if draft %}<p class="draft-label"><strong>Draft</strong></p>{% endif %}
    {% if date %}<p class="meta"><time datetime="{{ date }}">{{ date }}</time></p>{% endif %}
    {% if summary %}<p>{{ summary }}</p>{% endif %}
    {% if role or client or tools or year or link or (projectTags | length) %}
    <dl>
      {% if role %}<dt>Role</dt><dd>{{ role }}</dd>{% endif %}
      {% if client %}<dt>Client</dt><dd>{{ client }}</dd>{% endif %}
      {% if tools %}<dt>Tools</dt><dd>{% if tools is string %}{{ tools }}{% else %}{{ tools | join(", ") }}{% endif %}</dd>{% endif %}
      {% if year %}<dt>Year</dt><dd>{{ year }}</dd>{% endif %}
      {% if projectTags | length %}<dt>Tags</dt><dd>{% for t in projectTags %}<a href="/tags/{{ t.slug }}/">{{ t.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>{% endif %}
      {% if link %}<dt>Link</dt><dd><a href="{{ link }}">{{ link }}</a></dd>{% endif %}
    </dl>
    {% endif %}
    {{ content | safe }}
  </main>
</body>
</html>
